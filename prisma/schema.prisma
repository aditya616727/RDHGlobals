datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  category       String         // "food" or "textile"
  subcategory    String?        // e.g. "Raw Makhana", "Luxury Linens"
  description    String
  shortDesc      String?
  gradeInfo      String?        // e.g. "4 Suta", "5 Suta", "6 Suta", "400 Thread Count"
  moq            String?        // e.g. "500 KG", "100 Sets"
  packaging      String?        // e.g. "Moisture-sealed 10kg boxes"
  hsCode         String?        // e.g. "0813.40.90", "6302.21"
  specifications String?        // JSON string of key-value specs
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  sortOrder      Int            @default(0)
  seoTitle       String?
  seoDescription String?
  images         ProductImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id              String   @id @default(cuid())
  companyName     String
  contactName     String?
  email           String
  phone           String?
  country         String
  productInterest String?
  volume          String?
  timeline        String?
  message         String
  status          String   @default("NEW") // NEW, CONTACTED, QUOTED, WON, LOST
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  attribution String
  category    String   // "food" or "textile"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Newsletter {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model ExportCountry {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  flagEmoji String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}
